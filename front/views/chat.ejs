<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/chat.css">
    <script src="https://code.jquery.com/jquery-3.7.1.js" integrity="sha256-eKhayi8LEQwp4NKxN+CfCh+3qOVUtJn3QNZ0TciWLP4=" crossorigin="anonymous"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="/javascripts/chat.js" defer></script>
    <title>채팅</title>
</head>
<body>
<input type="hidden" id="hiddenUsername" value="<%= username %>">
<h1 style="text-align: center">채팅방</h1>
<h2 style="text-align: center">로그인한 사용자: <%= username %> <br/>대화상대 : <span id="titlebar">전체 채팅</span> </h2>
<div class="container">
    <!-- 좌측 사용자 목록 -->
    <div class="user-list">
        <h3>사용자 목록></h3>
        <ul>
            <li data-user="all">전체 채팅</li>
            <% userList.forEach(user => { %>
                <li data-user="<%= user %>"><%= user %></li>
            <% }) %>
        </ul>
    </div>
    <!-- 우측 채팅창 -->
    <div class="chat-section">
        <div id="chat-box"></div>
        <input type="text" id="message-input" placeholder="메시지를 입력하세요..." />
        <button id="send-btn">전송</button>
    </div>
</div>
</body>
</html>
